# Supabase: VercelのRoute HandlerとBetter Authが使用するTransaction pooler（6543）
DATABASE_URL=postgresql://tricksight_app.PROJECT_REF:APP_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require

# Supabase: Drizzle migrationとpg_dumpが使用する管理用接続
DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require

# アプリ専用DBロール。パスワードは `openssl rand -hex 32` で生成する
APP_DB_ROLE=
APP_DB_PASSWORD=

# Better Auth: `openssl rand -base64 32`で生成するランダムな値
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AWS: ローカルのPhase 0検証と開発だけで使用する認証情報。本番Vercelには設定しない
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ACCESS_KEY_IDがASIAで始まる一時認証情報を使う場合だけ設定する
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-1
# BedrockへS3 URIを渡す際のbucketOwner。12桁のAWSアカウントIDを設定する
AWS_ACCOUNT_ID=123456789012
S3_BUCKET_NAME=tricksight-dev-561143850472-ap-northeast-1-an

# Nova 2 Liteは推論プロファイルIDを指定する。jpプロファイルは東京からのみ呼び出せる
# 処理先は東京・大阪に限定されるため、AWS_REGIONと動画S3を東京にそろえる
NOVA_MODEL_ID=jp.amazon.nova-2-lite-v1:0
PEGASUS_MODEL_ID=twelvelabs.pegasus-1-2-v1:0

# 本番の分析経路。未設定ならbedrock-nova。比較・切り戻し時は
# twelvelabs-directまたはbedrock-pegasusを明示する
VIDEO_ANALYSIS_PROVIDER=bedrock-nova

# TwelveLabs公式API: Phase 0ではIndex不要のPegasus 1.5同期分析を使う
TWELVELABS_API_KEY=
TWELVELABS_MODEL_NAME=pegasus1.5

# AWS: Vercel Production環境だけに設定するOIDCロール。存在すればOIDC、未設定ならSDK既定チェーンを使う
# VERCEL_OIDC_TOKENはVercelが自動供給するため手動設定しない
AWS_ROLE_ARN=
