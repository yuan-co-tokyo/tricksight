{
  "name": "tricksight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup-role": "node --env-file=.env.local --import tsx scripts/setup-app-role.ts",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed-database.ts",
    "db:check": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs check",
    "db:verify": "node --env-file=.env.local --import tsx scripts/verify-database.ts",
    "auth:schema": "node --env-file=.env.local node_modules/auth/dist/index.mjs generate --config ./lib/auth.ts --output ./lib/db/schema/auth.ts --yes",
    "eval": "node --env-file=.env.local --import tsx scripts/eval-video.ts",
    "eval:twelvelabs": "node --env-file=.env.local --import tsx scripts/eval-twelvelabs.ts",
    "verify:twelvelabs": "node --env-file=.env.local --import tsx scripts/verify-twelvelabs.ts",
    "verify:aws": "node --env-file=.env.local --import tsx scripts/verify-aws.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1107.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1107.0",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/client-sts": "^3.1107.0",
    "@base-ui/react": "^1.6.0",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twelvelabs-js": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.6.27",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
